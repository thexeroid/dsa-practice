#!/usr/bin/env bash
# Compile and run a solution: ./run problems/foo.cpp [< input]
set -e
mkdir -p bin
out="bin/$(basename "${1%.cpp}")"
flags=(-std=c++20 -O2 -Wall -Wextra -Wshadow -D_GLIBCXX_ASSERTIONS)
# Memory-bug checks if installed (sudo dnf install libasan libubsan)
if echo 'int main(){}' | g++ -x c++ -fsanitize=address,undefined -o /dev/null - 2>/dev/null; then
  flags+=(-fsanitize=address,undefined)
fi
g++ "${flags[@]}" -o "$out" "$1"
"$out"
